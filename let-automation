#!/bin/bash
# let-automation: Main entry point for LowEndTalk automation workflow
# 
# WORKFLOW: Deterministic Pipeline (Replaces Power Query)
#   1. Fetch from LowEndTalk API (programmatic, not browser)
#   2. Parse & extract specs (vCPU, RAM, Storage, etc.)
#   3. Deduplicate programmatically (deterministic, not formula)
#   4. Generate Excel with:
#      - Deals Tracker (color-coded: 🟢NEW 🔵ACTIVE ⚪EXPIRED 🔴DUPLICATE)
#      - Deduplicated View (unique only)
#      - Offer Details (technical specs)
#      - Dashboard (metrics & stats)
#   5. Optional: Sync to GitHub
#
# Usage:
#   let-automation sync              # Full sync
#   let-automation sync --github     # Include GitHub
#   let-automation fetch             # Just fetch deals
#   let-automation excel             # Just update Excel
#
# VS OLD POWER QUERY WORKFLOW:
#   ❌ Old: Manual Power Query → Excel formula dedupe → Copy-paste Offer Details
#   ✅ New: One command → Fetched → Parsed → Deduplicated → Excel auto-generated

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOWS_DIR="$SCRIPT_DIR/workflows"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python"
if [ -x "$VENV_PYTHON" ]; then
    PYTHON="$VENV_PYTHON"
else
    PYTHON="python3"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check dependencies
check_deps() {
    local missing=()
    
    if ! command -v "$PYTHON" &> /dev/null; then
        missing+=("python3")
    fi
    
    if ! "$PYTHON" -c "import pandas" 2>/dev/null; then
        missing+=("pandas")
    fi
    
    if ! "$PYTHON" -c "import openpyxl" 2>/dev/null; then
        missing+=("openpyxl")
    fi
    
    if ! "$PYTHON" -c "import requests" 2>/dev/null; then
        missing+=("requests")
    fi
    
    if ! "$PYTHON" -c "import bs4" 2>/dev/null; then
        missing+=("beautifulsoup4")
    fi
    
    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${RED}❌ Missing dependencies:${NC}"
        printf '  - %s\n' "${missing[@]}"
        echo ""
        echo "Install with: pip install pandas openpyxl requests beautifulsoup4"
        exit 1
    fi
}

# Show help
show_help() {
    cat << 'EOF'
┌─────────────────────────────────────────────────────────────────────────┐
│  🤖 let-automation: LowEndTalk Deals Automation                        │
│                                                                         │
│  DETERMINISTIC PIPELINE (No Power Query Needed!)                       │
│  ┌─────────────┐    ┌─────────────┐    ┌─────────────┐    ┌─────────┐  │
│  │   Fetch     │───▶│   Parse     │───▶│  Deduplicate│───▶│  Excel  │  │
│  │  (API/RSS)  │    │Extract Specs│    │(deterministic)   │+GitHub  │  │
│  └─────────────┘    └─────────────┘    └─────────────┘    └─────────┘  │
│                                                                         │
│  VS OLD WORKFLOW:                                                       │
│  ❌ Power Query → Manual refresh → Formula dedupe → Copy-paste specs   │
│  ✅ One command → Auto-fetch → Auto-parse → Auto-dedupe → Auto-Excel   │
└─────────────────────────────────────────────────────────────────────────┘

USAGE:
  let-automation sync                    Full sync (fetch + Excel)
  let-automation sync --github           Include GitHub sync
  let-automation sync --dry-run          Preview what would happen

COMMANDS:
  sync                                   Full deterministic sync
  fetch                                  Fetch deals only (save to JSON)
  excel                                  Update Excel from existing data
  stats                                  Show Excel statistics
  cloud-run                              Run cloud pipeline (router -> spectral -> LET -> Excel)
  discover                               API discovery with spectral
  github-setup                           Setup GitHub repo

EXCEL OUTPUT (Auto-generated):
  📊 Sheet 1: Deals Tracker
     • All deals with color-coded status
     • 🟢 NEW (< 7 days) | 🔵 ACTIVE (7-30d) | ⚪ EXPIRED (> 30d)
     • 🔴 DUPLICATE highlighting
  
  📋 Sheet 2: Deduplicated View
     • Unique deals only (no duplicates)
  
  🔧 Sheet 3: Offer Details  
     • Technical specs: vCPU, RAM, Storage, Bandwidth, IPs
     • Auto-extracted from deal content
  
  📈 Sheet 4: Dashboard
     • Deal counts, provider breakdown
     • Price statistics, average specs
     • Last updated timestamp
  
  💾 Sheet 5: Raw Data
     • Complete data for reference

EXAMPLES:
  # Daily sync (recommended)
  let-automation sync

  # Sync with GitHub backup
  let-automation sync --github

  # Preview without changes
  let-automation sync --dry-run

  # Just fetch deals to JSON
  let-automation fetch

  # Force Excel update from existing data
  let-automation excel

  # Check your Excel stats
  let-automation stats

ENVIRONMENT VARIABLES:
  GITHUB_TOKEN          GitHub personal access token
  GITHUB_REPO           Target repo (default: hosting-deals-data)
  ANTHROPIC_API_KEY     Optional: for LLM features

FILES:
  Excel Output: ~/workspace/Hosting-Deals-Tracker.xlsx
  Data Cache:   ~/.let-automation/data/
EOF
}

# Main
main() {
    if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        show_help
        exit 0
    fi
    
    check_deps
    
    COMMAND="$1"
    shift
    
    case "$COMMAND" in
        sync)
            echo -e "${BLUE}🚀 Running deterministic sync...${NC}"
            "$PYTHON" "$WORKFLOWS_DIR/auto_sync.py" "$@"
            ;;
        
        fetch)
            echo -e "${BLUE}📡 Fetching deals from LowEndTalk...${NC}"
            "$PYTHON" "$SCRIPT_DIR/fetcher/let_api_fetcher.py" --pages 3 --output latest.json
            echo -e "${GREEN}✓ Deals saved to: ~/.let-automation/data/latest.json${NC}"
            ;;
        
        excel|update-excel)
            echo -e "${BLUE}📝 Updating Excel...${NC}"
            "$PYTHON" "$SCRIPT_DIR/excel-sync/deterministic_excel.py" --full-sync "$@"
            ;;
        
        stats)
            echo -e "${BLUE}📊 Showing statistics...${NC}"
            "$PYTHON" "$SCRIPT_DIR/excel-sync/excel_manager.py" --stats
            ;;

        cloud-run)
            echo -e "${BLUE}☁️ Running cloud pipeline locally...${NC}"
            "$PYTHON" "$SCRIPT_DIR/workflows/cloud_run.py" "$@"
            ;;
        
        discover)
            echo -e "${BLUE}🔍 API Discovery with Spectral...${NC}"
            "$PYTHON" "$SCRIPT_DIR/spectral-bridge/let_spectral.py" discover "$@"
            ;;
        
        github-setup)
            echo -e "${BLUE}🐙 Setting up GitHub repo...${NC}"
            "$PYTHON" "$SCRIPT_DIR/github-sync/github_uploader.py" --setup "$@"
            ;;
        
        *)
            # Treat as natural language command for LLM router
            echo -e "${BLUE}🎯 Processing: \"$COMMAND $@\"${NC}"
            "$PYTHON" "$SCRIPT_DIR/workflows/workflow_executor.py" --command "$COMMAND $@"
            ;;
    esac
}

main "$@"
